# OpenAI-compatible API (optional — richer replies)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Company settings
COMPANY_NAME=Tatweer Real Estate
DEFAULT_LANGUAGE=en

# Public URL for webhooks (use ngrok in local dev)
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Telegram bot (@BotFather)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# Twilio — WhatsApp + phone calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_PHONE_NUMBER=+1234567890
ADMIN_WHATSAPP_NUMBER=whatsapp:+966500000000

# Google Sheets appointments log
GOOGLE_SHEETS_CREDENTIALS_FILE=./credentials/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Appointments
